{
	"schemaVersion": 1,
	"id": "areatools",
	"version": "${version}",
	"name": "Area Tools",
	"description": "Hammers and excavators across five materials that break blocks in an area, with flat, wide and deep modes: sneak and right-click to cycle modes. Sizes are configurable in config/areatools.json.",
	"authors": [
		"AlexF6"
	],
	"contact": {
		"homepage": "https://github.com/AlexF6/areatools",
		"sources": "https://github.com/AlexF6/areatools",
		"issues": "https://github.com/AlexF6/areatools/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/areatools/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.alexf6.areatools.AreaToolsMod"
		],
		"client": [
			"io.github.alexf6.areatools.client.AreaToolsClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.165.2+26.3"
	}
}
